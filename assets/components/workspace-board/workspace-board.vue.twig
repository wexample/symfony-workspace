{%- extends '@WexampleSymfonyDesignSystemBundle/components/_abstract/vue/vue.vue.twig' -%}

{%- block vue_config -%}
    {{ parent() }}
    {{ trans_js(render_pass, 'WexampleSymfonyWorkspaceBundle.components.workspace-board.workspace-board::*') }}
{%- endblock -%}

{%- block vue_require -%}
    {{- vue_require(render_pass, '@WexampleSymfonyDesignSystemBundle/components/zone-tiling') -}}
    {{- vue_require(render_pass, '@WexampleSymfonyDesignSystemBundle/components/choice-list') -}}
    {{- vue_require(render_pass, '@WexampleSymfonyDesignSystemBundle/components/button-menu') -}}
    {#- The widgets it offers are the widgets it can draw: their vues are
        required with it. -#}
    {%- for widget in widgets|default([]) -%}
        {{- vue_require(render_pass, widget.view) -}}
    {%- endfor -%}
    {%- if toolbar|default(null) -%}
        {{- vue_require(render_pass, toolbar.view) -}}
    {%- endif -%}
{%- endblock -%}

{%- set picker -%}
<div class="workspace-board--picker">
                    <p v-if="zone.widget && !widgetsByName[zone.widget]" class="workspace-board--picker-notice">[[ t('picker.unknown', { '%name%': zone.widget }) ]]</p>
                    <p v-if="!widgets.length" class="workspace-board--picker-notice">[[ t('picker.none') ]]</p>
                    <choice-list
                            class="workspace-board--choices"
                            :items="pickerChoices"
                            :model-value="zone.widget || null"
                            :filter-from="pickerFilterFrom"
                            :label="t('picker.title')"
                            @change="pick(zone, $event)"
                    ></choice-list>
                </div>
{%- endset -%}

{#- What a zone shows: its widget in the frame every widget is given — a
    zone that scrolls, the widget's own `zone--content` inside —, or the
    widgets to choose one from. -#}
{%- set widget_frame -%}
                <div v-if="showsWidget(zone)" class="zone zone--scrollable workspace-board--widget">
                    <component
                            v-if="widgetComponent(zone.widget)"
                            :is="widgetComponent(zone.widget)"
                            :zone-id="zone.id"
                            :config="zone.config || {}"
                            :subject="subjects[zone.id] || null"
                            :context="context"
                            :scope="values"
                            :workspace="api"
                            :alone="Boolean(soloZone)"
                    ></component>
                </div>
                {#- Nothing chosen yet — or something no longer offered —: the
                    widgets the page offers, to choose one. -#}
                <div v-else class="workspace-board--choose">
                    {{ picker }}
                </div>
{%- endset -%}

{%- block vue_body -%}
    <div class="workspace-board">
        {#- The bar over the whole board. Its start moves between the
            arrangements the page keeps; its end concerns this
            one: the page's own bar — what its widgets share —, then arranging
            it. -#}
        <div class="toolbar toolbar--compact workspace-board--bar">
            <div v-if="layoutUrls && !soloZone" class="toolbar--group workspace-board--bar-start">
                {#- An arrangement named in place: made, or the one shown renamed. -#}
                <form v-if="naming" class="form--input-group workspace-board--naming" @submit.prevent="submitNaming">
                    <input
                            ref="namingInput"
                            v-model="naming.value"
                            class="form--input"
                            type="text"
                            maxlength="255"
                            :placeholder="t('layouts.name')"
                            :aria-label="t('layouts.name')"
                            @keydown.esc="naming = null"
                    >
                    <button type="submit" class="form--input-action" :aria-label="t('layouts.save')" :title="t('layouts.save')" v-html="renderIcon('ph:bold/check')"></button>
                </form>
                {#- The one shown, the others to go to; in its frame, what is
                    done to them. -#}
                <div v-else class="form--input-group workspace-board--layouts">
                    <select
                            class="form--input form--input--select"
                            :aria-label="t('layouts.label')"
                            :title="t('layouts.label')"
                            :value="currentLayoutId || ''"
                            @change="selectLayout($event.target.value)"
                    >
                        <option v-if="!currentLayoutId" value="">[[ t('layouts.unnamed') ]]</option>
                        <option v-for="layout in layoutList" :key="layout.id" :value="layout.id">[[ layoutLabel(layout) ]]</option>
                    </select>
                    <button-menu
                            icon="ph:bold/dots-three-vertical"
                            :items="layoutMenuItems"
                            :attr="{ 'aria-label': t('layouts.actions'), 'data-tooltip': t('layouts.actions') }"
                            @select="onLayoutMenu"
                    ></button-menu>
                </div>
            </div>
            <div class="toolbar--group workspace-board--bar-end">
                <component
                        v-if="toolbar && toolbarComponent()"
                        :is="toolbarComponent()"
                        :values="values"
                        :subject="subject"
                        :context="context"
                        :workspace="api"
                ></component>
                {#- Arranging the board, last: an icon, its words its tooltip.
                    A zone alone in its window leads back to the board; a
                    widget opened in a panel has the panel's close. -#}
                <a
                        v-if="soloZone && !openedZone"
                        class="action-icon"
                        :href="boardUrl"
                        :aria-label="t('zone.back')"
                        :data-tooltip="t('zone.back')"
                        v-html="renderIcon('ph:bold/squares-four')"
                ></a>
                <button
                        v-else-if="!openedZone"
                        type="button"
                        class="action-icon"
                        :aria-pressed="editing ? 'true' : 'false'"
                        :aria-label="editLabel"
                        :data-tooltip="editLabel"
                        @click="editing = !editing"
                        v-html="editIconHtml"
                ></button>
            </div>
        </div>
        {#- One zone alone, in a window of its own (`workspace_zone` in the
            address), or the widget opened in a panel on an event (`opened`):
            its widget, the board's bar over it. -#}
        <div v-if="soloZone" class="zone zone--panel workspace-board--solo">
            <template v-for="zone in [soloZone]" :key="zone.id">
                {{ widget_frame }}
            </template>
        </div>
        <zone-tiling
                v-else
                ref="tiling"
                :model-value="tree"
                :flush="flush"
                :zone-menu="zoneMenuItems"
                :zone-label="zoneLabel"
                :zone-sizing="zoneSizing"
                :editing="editing"
                @update:model-value="onTreeChange"
        >
            <template #zone="{ zone }">
                {{ widget_frame }}
            </template>
            {#- The board being arranged: in every zone, the widgets to put in
                it, the one it shows marked. -#}
            <template #edit="{ zone }">
                <div class="workspace-board--choose">
                    {{ picker }}
                </div>
            </template>
        </zone-tiling>
    </div>
{%- endblock -%}
