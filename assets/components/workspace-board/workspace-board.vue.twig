{%- extends '@WexampleSymfonyDesignSystemBundle/components/_abstract/vue/vue.vue.twig' -%}

{%- block vue_config -%}
    {{ parent() }}
    {{ trans_js(render_pass, 'WexampleSymfonyWorkspaceBundle.components.workspace-board.workspace-board::*') }}
{%- endblock -%}

{%- block vue_require -%}
    {{- vue_require(render_pass, '@WexampleSymfonyDesignSystemBundle/components/zone-tiling') -}}
    {{- vue_require(render_pass, '@WexampleSymfonyDesignSystemBundle/components/choice-list') -}}
    {#- The widgets it offers are the widgets it can draw: their vues are
        required with it. -#}
    {%- for widget in widgets|default([]) -%}
        {{- vue_require(render_pass, widget.view) -}}
    {%- endfor -%}
    {%- if toolbar|default(null) -%}
        {{- vue_require(render_pass, toolbar.view) -}}
    {%- endif -%}
{%- endblock -%}

{%- set picker -%}
<div class="workspace-board--picker">
                    <p class="workspace-board--picker-title">[[ t('picker.title') ]]</p>
                    <p v-if="zone.widget && !widgetsByName[zone.widget]" class="workspace-board--picker-notice">[[ t('picker.unknown', { '%name%': zone.widget }) ]]</p>
                    <p v-if="!widgets.length" class="workspace-board--picker-notice">[[ t('picker.none') ]]</p>
                    <choice-list
                            class="workspace-board--choices"
                            :items="pickerChoices"
                            :model-value="zone.widget || null"
                            :filter-from="pickerFilterFrom"
                            :label="t('picker.title')"
                            @change="pick(zone, $event)"
                    ></choice-list>
                </div>
{%- endset -%}

{#- What a zone shows: its widget in the frame every widget is given — a
    zone that scrolls, the widget's own `zone--content` inside —, or the
    widgets to choose one from. -#}
{%- set widget_frame -%}
                <div v-if="showsWidget(zone)" class="zone zone--scrollable workspace-board--widget">
                    <component
                            v-if="widgetComponent(zone.widget)"
                            :is="widgetComponent(zone.widget)"
                            :zone-id="zone.id"
                            :config="zone.config || {}"
                            :subject="subjects[zone.id] || null"
                            :context="context"
                            :scope="values"
                            :workspace="api"
                    ></component>
                </div>
                {#- Nothing chosen yet — or something no longer offered —: the
                    widgets the page offers, to choose one. -#}
                <div v-else class="workspace-board--choose">
                    {{ picker }}
                </div>
{%- endset -%}

{%- block vue_body -%}
    <div class="workspace-board">
        {#- The bar over the whole board. Its start is left for moving between
            boards; its end concerns this one: the page's own bar — what its
            widgets share —, then arranging it. -#}
        <div class="toolbar toolbar--compact workspace-board--bar">
            <div class="toolbar--group workspace-board--bar-end">
                <component
                        v-if="toolbar && toolbarComponent()"
                        :is="toolbarComponent()"
                        :values="values"
                        :subject="subject"
                        :context="context"
                        :workspace="api"
                ></component>
                {#- Arranging the board, last: an icon, its words its tooltip.
                    A zone alone in its window leads back to the board. -#}
                <a
                        v-if="soloZone"
                        class="action-icon"
                        :href="boardUrl"
                        :aria-label="t('zone.back')"
                        :data-tooltip="t('zone.back')"
                        v-html="renderIcon('ph:bold/squares-four')"
                ></a>
                <button
                        v-else
                        type="button"
                        class="action-icon"
                        :aria-pressed="editing ? 'true' : 'false'"
                        :aria-label="editLabel"
                        :data-tooltip="editLabel"
                        @click="editing = !editing"
                        v-html="editIconHtml"
                ></button>
            </div>
        </div>
        {#- One zone alone, in a window of its own (`workspace_zone` in the
            address): its widget, the board's bar over it. -#}
        <div v-if="soloZone" class="zone zone--panel workspace-board--solo">
            <template v-for="zone in [soloZone]" :key="zone.id">
                {{ widget_frame }}
            </template>
        </div>
        <zone-tiling
                v-else
                ref="tiling"
                :model-value="tree"
                :flush="flush"
                :zone-menu="zoneMenuItems"
                :zone-label="zoneLabel"
                :zone-sizing="zoneSizing"
                :editing="editing"
                @update:model-value="onTreeChange"
        >
            <template #zone="{ zone }">
                {{ widget_frame }}
            </template>
            {#- The board being arranged: in every zone, the widgets to put in
                it, the one it shows marked. -#}
            <template #edit="{ zone }">
                <div class="workspace-board--choose">
                    {{ picker }}
                </div>
            </template>
        </zone-tiling>
    </div>
{%- endblock -%}
